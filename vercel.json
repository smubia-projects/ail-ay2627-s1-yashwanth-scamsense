{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p public && cp -r game public/",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/", "destination": "/game/index.html" }],
  "functions": {
    "api/*.py": {
      "maxDuration": 30,
      "includeFiles": "{game/personas.json,knowledge/**,pipeline/**,llm/**,sim/__init__.py,sim/gamechat.py,sim/gameapi.py,config.py,strings.py}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
