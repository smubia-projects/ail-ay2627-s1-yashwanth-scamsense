# --- LLM (default: Groq). Get a key at https://console.groq.com
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_S=25
# Llama Prompt Guard 2 injection classifier (extra layer; measured in eval)
USE_PROMPT_GUARD=true
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
PROMPT_GUARD_THRESHOLD=0.8

# --- Telegram (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
# Leave WEBHOOK_URL empty to use long polling. For Railway/Render set it to https://<your-app-domain>
WEBHOOK_URL=
PORT=8080

# --- Limits
MAX_INPUT_CHARS=6000
MAX_MESSAGES=60
RATE_LIMIT_ANALYSES=6
RATE_LIMIT_WINDOW_S=600
SESSION_TTL_S=1800

# --- Optional stretch: screenshot input
# OCR is local (Tesseract). USE_VISION=true would send the RAW IMAGE to the LLM provider - off by default.
USE_VISION=false
