# ScamSense web API (Cloud Run). Copy to .env, fill in, then: gh secret set DOTENV --repo smubia-projects/ail-ay2627-s1-yashwanth-scamsense < .env
# Never commit .env. Keep values free of inline comments (put comments on their own lines).

# --- LLM via OpenRouter (https://openrouter.ai/keys). Without a key the game runs on scripted replies + a bannered offline scanner.
API_KEY=
MODEL_NAME=openai/gpt-oss-120b
FALLBACK_MODEL_NAME=meta-llama/llama-3.3-70b-instruct
LLM_TIMEOUT_S=25
# Prompt Guard classifier layer: off (not available on OpenRouter; the eval showed no measurable difference)
USE_PROMPT_GUARD=false

# --- CORS: comma-separated frontend origins (set to the Vercel URL after the first deploy)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limiting (shared AI Lodge engine on Upstash Redis). Unset Upstash vars = limiting disabled (local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Fallback per-IP limits per window; the central control sheet overrides these at runtime.
# chat = one AI-voiced reply per typed message; probe = intent classification (used when chat is unavailable);
# scan = full ScamSense pipeline over a storyline (Scanner power-up)
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_PROBE_MAX=30
RATE_LIMIT_SCAN_MAX=5
RATE_LIMIT_WINDOW_SECONDS=432000

# --- Pipeline input limits
MAX_INPUT_CHARS=6000
MAX_MESSAGES=60

# --- Telegram bot (phase 2, NOT deployed in v1; only needed for `python -m bot.app` locally)
# TELEGRAM_BOT_TOKEN=
# WEBHOOK_URL=
# RATE_LIMIT_ANALYSES=6
# RATE_LIMIT_WINDOW_S=600
# SESSION_TTL_S=1800
# USE_VISION=false
